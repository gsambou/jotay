# Copier vers .env en local. Aucune valeur secrète réelle dans ce fichier.
DATABASE_URL=postgres://jotay:jotay@127.0.0.1:5432/jotay
PORT=3000
# 1 = journalise l'OTP en clair (local uniquement). Interdit en production.
JOTAY_DEV_OTP=0
JOTAY_SECURE_COOKIES=1
# Placeholders de seed local (`pnpm --filter @jotay/api seed`).
JOTAY_SEED_MERCHANT_KEY=dev-merchant-key-change-me
JOTAY_SEED_SUPERVISOR_KEY=dev-supervisor-key-change-me
